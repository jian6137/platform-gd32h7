# GigaDevice GD-Link / GDLinker_V2 / CMSIS-DAP & DFU USB udev rules
# Copy to /etc/udev/rules.d/99-gdlink.rules and run:
#   sudo udevadm control --reload-rules && sudo udevadm trigger

# GD-Link V1 / V2 / CMSIS-DAP (0x28e9:0x0497, 0x28e9:0x058f, 0x28e9:0x018a, 0x28e9:0x0189)
SUBSYSTEM=="usb", ATTR{idVendor}=="28e9", MODE="0666", TAG+="uaccess", ENV{ID_MM_DEVICE_IGNORE}="1"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="28e9", MODE="0666", TAG+="uaccess"

